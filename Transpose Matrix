
void fun(int i, int j, vector<vector<int>>& matrix,
            vector<vector<int>>& ans) {

    int n = matrix.size();
    int m = matrix[0].size();

    if(i == n)
        return;

        ans[j][i] = matrix[i][j];

        if(j == m - 1)
            fun(i + 1, 0, matrix, ans);
        else
            fun(i, j + 1, matrix, ans);
    }
class Solution {
public:
    vector<vector<int>> transpose(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();

        vector<vector<int>> ans(m, vector<int>(n));

        fun(0, 0, matrix, ans);

        return ans;
    }
};
