class Solution {
public:
    int countSuffix(vector<int>& nums, vector<int>& tar) {
        vector<int>pre;
        int c=0;
        int pp=nums.size()-1;


        for(int i=nums.size()-2;i>=0;i--){
            if(tar[i]>=tar[i+1]) pp=i;
            else break;
        }

        for(int i=0;i<nums.size();i++){
           if(nums[i]==tar[i]) c++;
           pre.push_back(c);
        }


        map<int,int>m1;
        int ans=0;

        for(int i=nums.size()-1;i>=pp;i--){
           m1[nums[i]]++;
           m1[tar[i]]--;
           if(m1[tar[i]]==0) m1.erase(tar[i]);
           if(m1[nums[i]]==0) m1.erase(nums[i]);


           //cout<<i<<","<<m1.size()<<" ";


           if(i>0 && m1.size()==0 && pre[i-1]==i) ans++;
           if(i==0 && m1.size()==0) ans++;
        }




        //for(auto a:pre)  cout<<a<<" ";

        return ans;
    }
};
