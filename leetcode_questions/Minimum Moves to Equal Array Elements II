class Solution {
public:
    int minMoves2(vector<int>& nums) {
        sort(nums.begin(),nums.end());

        // for(auto a:nums){
        //     cout<<a<<" ";
        // }

        int idx=-1;

        if(nums.size()%2==0){
            idx=nums.size()/2;
        }
        else{
            idx=nums.size()/2;
        }

       // cout<<nums[idx]<<" ";

        int k=0;


        for(auto a:nums){
            k+=abs(a-nums[idx]);
        }


        return k;
    }
};
