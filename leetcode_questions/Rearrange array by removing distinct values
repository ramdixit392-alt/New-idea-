class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        map<int, int> mp;
        for(int x : nums){
            mp[x]++;
        }
        vector<int> ans;
        while(!mp.empty()){
            vector<int> remove;

            for(auto &p : mp){

                ans.push_back(p.first);
                p.second--;
                if(p.second == 0){
                    remove.push_back(p.first);
                }
            }
            for(int x : remove){
                mp.erase(x);
            }
        }
        return ans;
    }
};
