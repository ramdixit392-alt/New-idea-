int dp[100003];

int fun(int i,vector<int>&nums){
    int n=nums.size();
    if(i==nums.size()-1) return 0;

    if(i>=nums.size()) return 1e9;

    int m=1e9;

    if(dp[i]!=-1) return dp[i];

    for(int j=i+1;j<=min(i+3,n-1);j++){
       int aa=(j-i)*(j-i) + nums[j] + fun(j,nums);
       m=min(m,aa);
    }
    return dp[i]=m;

}

class Solution {
public:
    int climbStairs(int n, vector<int>& costs) {
        costs.insert(costs.begin(),0);
        memset(dp,-1,sizeof(dp));
        return fun(0,costs);
    }
};
