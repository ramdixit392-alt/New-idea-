int dp[50];
int fun(int curr, int n){
    if(curr == n) return 1;
    if(curr > n) return 0;

    if(dp[curr] != -1) return dp[curr];
    int k = fun(curr + 1, n)+ fun(curr + 2, n);
    return dp[curr] = k;
}

class Solution {
public:
    int climbStairs(int n) {
        memset(dp, -1, sizeof(dp));
        return fun(0, n);
        
    }
};
