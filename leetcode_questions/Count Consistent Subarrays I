int fun(int l,int r,vector<int>&nums){

    int a=nums[l];

    int m=nums[l];
    for(int i=l+1;i<=r;i++){
        a=a & nums[i];
        m=min(m,nums[i]);
    }

    return m==a;
}

class Solution {
public:
    int countConsistent(vector<int>& nums) {
        int ans=0;
        for(int i=0;i<nums.size();i++){
            for(int j=i;j<nums.size();j++){
                if(fun(i,j,nums)==1) ans++;
            }
        }
        return ans;
    }
};
