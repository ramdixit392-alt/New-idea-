class Solution {
public:
    vector<int> maxPrimes(int n, int s) {
        vector<bool> prime(n + 1, true);
        prime[0] = prime[1] = false;

        for(int i = 2; 1LL * i * i <= n; i++){
           
            if(prime[i]){
                for(int j = i*i; j <= n; j +=i)
                prime[j] = false;
            }
            }
        vector<int> ans;
        for(int i = 2; i <= n; i++){
        
            if(prime[i] && i <= s){
                    ans.push_back(i);
                    s -= i;
                }
            }
            return ans;
    }
};
