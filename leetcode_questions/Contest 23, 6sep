class Solution(object):
    def isPalindromic(self, s):
        binary_string = ''.join(format(ord(char),'08b') for char in s)
        return binary_string == binary_string[::-1]
        
# count good rotation
class Solution {
public:
    int count(vector<int>& nums, int start, long long first, long long total){
        int n = nums.size();

        if(start == n)
           return 0;
        int ans = 0;

        if(first > total -first)
          ans = 1;

        long long next = first - nums[start] + nums[(start + n / 2) % n];

        return ans + count(nums, start + 1, next, total);
        
    }
    int countGoodRotations(vector<int>& nums) {
        int n = nums.size();

        long long total = 0;
        long long first = 0;

        for(int x : nums)
            total += x;
        for(int i = 0; i < n / 2; i++)
        first += nums[i];

        return count(nums, 0, first, total);
        
    }
};
