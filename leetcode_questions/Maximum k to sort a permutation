class Solution {
public:
    int sortPermutation(vector<int>& nums) {
        int ans=0;
        int m=1e9;
        for(int i=0;i<nums.size();i++){
            if(nums[i]==i) continue;
            if(ans==0){
                ans=nums[i];
                continue;
            }
            ans=ans & nums[i];
            m=min(m,ans);
        }
        if(m==1e9) return 0;
        return m;
    }
};
