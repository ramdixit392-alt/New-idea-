int dp[101][101][201];

int fun(int i,int j,int k,string &s,string &t,string &str){
    if(i>=s.size()){
        while(j<t.size() && k<str.size()){
            if(t[j]==str[k]){
                j++;
                k++;
            }else{
                return 0;
            }
        }
        return 1;
    }

    if(j>=t.size()){
        while(i<s.size() && k<str.size()){
            if(s[i]==str[k]){
                i++;
                k++;
            }else{
                return 0;
            }
        }
        return 1;
    }

    if(dp[i][j][k]!=-1) return dp[i][j][k];

    int m=0;

    if(s[i]==str[k]){
        int a=fun(i+1,j,k+1,s,t,str);
        m=m|a;
    }

    if(t[j]==str[k]){
        int b=fun(i,j+1,k+1,s,t,str);
        m=m|b;
    }

    if(s[i]!=str[k] && t[j]!=str[k]){
        return 0;
    }

    return dp[i][j][k]=m;
}
class Solution {
public:
    bool isInterleave(string s1, string s2, string s3) {
        if(s1.size()+s2.size()!=s3.size()) return 0;
        memset(dp,-1,sizeof(dp));
        return fun(0,0,0,s1,s2,s3);
    }
};
