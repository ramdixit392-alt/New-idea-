class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        vector<int>v1;
        vector<int>m1(105,0);

        for(auto a:nums){
            m1[a]++;
        }

        while(1){
            int f=0;
            for(int i=0;i<m1.size();i++){
                if(m1[i]>0){ v1.push_back(i); f=1;}
                m1[i]--;
            }
            if(f==0) break;
        }

        return v1;
    }
};
