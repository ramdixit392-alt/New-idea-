int dp[1005];

int fun(int i, vector<int>& nums, vector<int>& cost){
    if(i>=nums.size()) return 0;
    if(dp[i] != -1) return dp[i];
     
    int c1=cost[0] +fun(i+1, nums, cost);

    int id1=nums.size(); int id2= nums.size();

    // for(int j=i+1; j<nums.size(); j++){
    //     if(nums[j]>=nums[i]+7){
    //         id1=j;
    //         break;

    int l=i+1, h=nums.size()-1;

    while(l<=h){
        int mid = (l+h)/2;
        if(nums[mid]>=nums[i]+7){
            id1=mid;
            h=mid-1;
        }else{
            l=mid+1;
        }    
    }
     for(int j=i+1; j<nums.size(); j++){
        if(nums[j]>=nums[i]+30){
            id2=j;
            break;
        }
     }
     int c2=cost[1]+fun(id1,nums, cost);
     int c3=cost[2]+fun(id2, nums, cost);
     return dp[i]=min({c1, c2, c3});
    
}

class Solution {
public:
    int mincostTickets(vector<int>& days, vector<int>& costs) {
        memset(dp, -1, sizeof(dp));
        return fun(0, days,costs);
        
    }
};
