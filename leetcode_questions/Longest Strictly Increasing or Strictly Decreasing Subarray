class Solution {
public:
    int longestMonotonicSubarray(vector<int>& nums) {
        int m=1,a=1;
        for(int i=1;i<nums.size();i++){
            if(nums[i]>nums[i-1]) a++;
            else a=1;

            m=max(m,a);
        }

        a=1;

        for(int i=1;i<nums.size();i++){
            if(nums[i]<nums[i-1]) a++;
            else a=1;

            m=max(m,a);
        }

        return m;
    }
};
