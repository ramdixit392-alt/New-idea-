class Solution {
public:
    vector<string> createGrid(int m, int n) {
        vector<string>grid;
        string s;
        for(int i=0;i<n;i++) s+="#";
        for(int i=0;i<m;i++){
            grid.push_back(s);
        }

        for(int i=0;i<n;i++) grid[0][i]='.';
        
        for(int i=0;i<m;i++) grid[i][n-1]='.';
        
        return grid;
    }
};
