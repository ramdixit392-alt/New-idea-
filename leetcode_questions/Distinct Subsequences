int dp[1002][1002];

int fun(int i,int j,string &s,string &t){
    if(i>=s.size()){
        return j>=t.size();
    }
    if(j>=t.size()) return 1;

    if(dp[i][j]!=-1) return dp[i][j];


    int m=0;

    if(s[i]==t[j]){
        int a=fun(i+1,j+1,s,t);
        int b=fun(i+1,j,s,t);
        m=a+b;
    }else{
        int a=fun(i+1,j,s,t);
        m+=a;
    }

    return dp[i][j]=m;
}


class Solution {
public:
    int numDistinct(string s, string t) {
        memset(dp,-1,sizeof(dp));
        return fun(0,0,s,t);
    }
};
