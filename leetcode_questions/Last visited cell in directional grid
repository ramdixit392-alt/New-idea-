vector<int> fun(int r, int c, vector<vector<bool>>& nums,vector<vector<char>>& grid){
   int n = grid.size();
   int m = grid[0].size();

   nums[r][c] = true;
    int nr = r;
    int nc = c;

    if(grid[r][c] == 'L') nc--;
    else if(grid[r][c] == 'R') nc++;
    else if(grid[r][c] == 'U') nr--;
    else if(grid[r][c] == 'D') nr++; 

    if(nr < 0 || nr >= n || nc < 0 || nc >= m || nums[nr][nc]){
            return {r, c};
    }

    

    return fun(nr,nc,nums,grid);

}


class Solution {
public:
    vector<int> lastVisitedCell(vector<vector<char>>& grid) {
    int n = grid.size();
    int m = grid[0].size();
        
    vector<vector<bool>> nums(n, vector<bool>(m, false));

        return fun(0, 0, nums, grid);

    }
};
