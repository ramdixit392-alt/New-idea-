//Sum
let numbers = [1,3,4,5,2];
let nums = numbers.filter(function(n){
     return n % 2 == 1;
});
let sum = nums.reduce(function (acc, curr){
    return acc + curr;
}, 5);

console.log(sum);

//return the product of even no. in array [5,2,4,6,9,1]

//reduce 
let numbers = [5,2,4,6,9,1];
let nums = numbers.filter(function(n){
   return n % 2 == 0;
});
let product = nums.reduce(function (acc, curr){
    return acc * curr;
 }, 1);

 console.log(product);

