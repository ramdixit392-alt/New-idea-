int fun(int i, int j, vector<int>& prices) {

        if (j == prices.size())
            return 0;
        if (prices[j] <= prices[i])
            return prices[j];

        return fun(i, j + 1, prices);
    }
class Solution {
public:
    vector<int> finalPrices(vector<int>& prices) {
        
        for (int i = 0; i < prices.size(); i++) {

            int discount = fun(i, i + 1, prices);
            prices[i] = prices[i] - discount;
        }
        return prices;
    }
};
