class Solution {
public:
    string maxSumOfSquares(int num, int sum) {
        vector<int>v1(num,0);

        for(int i=0;i<num;i++){
            if(sum<=0) continue;
            v1[i]=min(9,sum);
            sum-=v1[i];
        }

        string ans;

        for(auto a:v1){
            ans+=to_string(a);
        }

        if(sum>0) return "";

        return ans;
    }
};
